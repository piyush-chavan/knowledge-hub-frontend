:root {
  /* Purple theme design tokens */
  --color-primary: #7c3aed;
  --color-primary-dark: #5b21b6;
  --color-primary-darker: #3b0764;
  --color-primary-light: #a78bfa;
  --color-primary-soft: #ede9fe;
  --color-accent: #c026d3;

  --gradient-primary: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
  --gradient-primary-hover: linear-gradient(135deg, #9d6bf9 0%, #7c3aed 100%);
  --gradient-page: linear-gradient(160deg, #f3e8ff 0%, #ede1fb 45%, #fbe7dd 100%);
  --gradient-ai: linear-gradient(135deg, #6366f1, #8b5cf6, #d946ef);

  --surface: #ffffff;
  --surface-soft: #f6f3fd;
  --surface-muted: #efe9fb;

  --text-heading: #241b3d;
  --text-body: #4a4159;
  --text-muted: #766e8a;
  --text-on-primary: #ffffff;

  --border-color: #e5defa;
  --border-color-strong: #d8cdf5;

  --danger: #e5484d;
  --danger-dark: #c53030;
  --success: #22c55e;
  --success-dark: #16a34a;

  --shadow-color: 260, 60%, 45%;
  --shadow-sm: 0 2px 8px rgba(124, 58, 237, 0.12);
  --shadow-md: 0 8px 24px rgba(124, 58, 237, 0.16);
  --shadow-lg: 0 16px 40px rgba(88, 28, 135, 0.24);

  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 18px;
  --radius-pill: 999px;

  --transition-fast: 0.18s ease;
  --transition-base: 0.25s ease;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
    'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
    sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

code {
  font-family: source-code-pro, Menlo, Monaco, Consolas, 'Courier New',
    monospace;
}

::selection {
  background: var(--color-primary-light);
  color: #ffffff;
}

/* Custom purple scrollbar */
::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(124, 58, 237, 0.45);
  border-radius: var(--radius-pill);
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(124, 58, 237, 0.7);
}

html {
  scrollbar-color: rgba(124, 58, 237, 0.45) transparent;
}
